{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@nexgen-connect/shared": ["../packages/shared/src/index.ts"],
      "@nexgen-connect/shared/*": ["../packages/shared/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../packages/shared/src/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
