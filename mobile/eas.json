{
  "$schema": "https://json.schemastore.org/eas.json",
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_TRPC_URL": "http://localhost:4000/api/trpc",
        "MOCK_OTP": "true",
        "MOCK_DIGILOCKER": "true",
        "DIGILOCKER_ENABLED": "false"
      }
    },

    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_TRPC_URL": "https://nexgen-connect-api-preview.vercel.app/api/trpc",
        "MOCK_OTP": "true",
        "MOCK_DIGILOCKER": "true",
        "DIGILOCKER_ENABLED": "false"
      }
    },

    "production": {
      "channel": "production",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_TRPC_URL": "https://nexgen-connect-api.vercel.app/api/trpc"
      }
    }
  },

  "submit": {
    "production": {
      "ios": {
        "appleId": "$APPLE_ID",
        "ascAppId": "$ASC_APP_ID",
        "appleTeamId": "$APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "../google-play-service-account.json",
        "track": "production",
        "releaseStatus": "draft"
      }
    },
    "preview": {
      "ios": {
        "appleId": "$APPLE_ID",
        "ascAppId": "$ASC_APP_ID",
        "appleTeamId": "$APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "../google-play-service-account.json",
        "track": "internal"
      }
    }
  }
}
