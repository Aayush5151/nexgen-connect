# NexGen Connect server — env template.
#
# Copy to .env.local for development. Production values live in
# Vercel project env vars (per Bucket 4 D1: dotenv-vault or Vercel env;
# never check secrets into git).

# Postgres (Supabase)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth peppers (per v15 BP §9.1 composite identity hash)
PHONE_PEPPER=
OTP_PEPPER=
SESSION_SECRET=
AADHAAR_REF_PEPPER=

# Mock toggles (development only)
MOCK_OTP=true
MOCK_DIGILOCKER=true
DIGILOCKER_ENABLED=false

# External integrations (mocks until KYC clears)
MSG91_AUTH_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
CLOUDFLARE_IMAGES_API_KEY=

# Observability
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SENTRY_DSN=

# Node env
NODE_ENV=development
