{
  "name": "@nexgen-connect/server",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server/router": {
      "types": "./src/server/router.ts",
      "default": "./src/server/router.ts"
    },
    "./server/context": {
      "types": "./src/server/context.ts",
      "default": "./src/server/context.ts"
    }
  },
  "scripts": {
    "dev": "next dev --port 4000",
    "build": "next build",
    "start": "next start --port 4000",
    "lint": "echo 'lint runs via root turbo'",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@nexgen-connect/shared": "*",
    "@trpc/server": "^11.0.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3",
    "next": "^16.2.4",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "@upstash/redis": "^1.36.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "~19.1.0",
    "drizzle-kit": "^0.31.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.7",
    "typescript": "~5.9.2"
  }
}
