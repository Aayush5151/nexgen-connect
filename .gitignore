# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ====================================================================
# Monorepo layout (v0.4.0): web + mobile + packages/shared, hoisted
# node_modules at root via npm workspaces, Turborepo cache at root.
# Patterns below cover all three workspaces; per-package .gitignore
# files are not needed.
# ====================================================================

# dependencies (any depth)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
**/coverage/

# next.js (web app)
**/.next/
**/out/

# expo + react-native (mobile app)
**/.expo/
**/.expo-shared/
**/dist/
mobile/ios/
mobile/android/
**/web-build/

# production builds
**/build/

# turborepo cache
.turbo/
**/.turbo/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel — link can live at root or inside web/
.vercel
**/.vercel

# typescript
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts
**/next-env.d.ts
