# Force npm to install optional dependencies (platform-specific binaries
# like @esbuild/linux-x64) regardless of the host platform. Without
# this, lockfiles generated on macOS skip the linux-* entries and CI
# (Linux runners) fails npm ci with "Missing: @esbuild/linux-x64 from
# lock file". See npm/cli#4828, npm/cli#4683.
#
# This is the documented escape hatch for monorepos that ship across
# platforms.
include=optional
