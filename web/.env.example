# NexGen Connect — web env reference
#
# Each block has the secrets a service needs PLUS a feature flag the
# client uses to decide whether to call the real API or the local mock.
# Production env MUST set the flag; mocks are only allowed in dev/preview.
#
# v16 web pivot §Bucket 6.

# -------------------------------------------------------------
# Core (always required in production)
# -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PHONE_PEPPER=                # `openssl rand -hex 32`
OTP_PEPPER=                  # `openssl rand -hex 32`
AADHAAR_REF_PEPPER=          # `openssl rand -hex 32`
SESSION_SECRET=              # `openssl rand -hex 32`
PARENT_LINK_SECRET=          # `openssl rand -hex 32`

# -------------------------------------------------------------
# Cloudflare Turnstile (signup phone-entry gate)
# -------------------------------------------------------------
# When TURNSTILE_SECRET_KEY is unset in dev, siteverify auto-mocks pass.
# In production, missing secret = fail-closed (E011:turnstile_not_configured).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
MOCK_TURNSTILE=              # "true" forces mock even when keys exist

# -------------------------------------------------------------
# MSG91 (phone OTP — fallback channel)
# -------------------------------------------------------------
# The /signup funnel now routes OTP through tRPC auth.requestOtp,
# which uses Meta WhatsApp as primary and MSG91 SMS as fallback
# (packages/server/src/server/lib/otp/router.ts). The legacy REST
# routes that wrapped MSG91 (/api/auth/send-otp + /api/auth/verify-
# otp) were removed in the cross-cut cleanup PR.
#
# These env vars stay because:
#   - the legacy /admin/login + waitlist server actions still use
#     web/src/lib/msg91.ts directly (cleanup deferred until those
#     surfaces migrate through tRPC)
#   - packages/server's MSG91 fallback provider reads the same auth
#     key + template id at the server tier
NEXT_PUBLIC_USE_REAL_MSG91=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=NXGNCN
MOCK_OTP=                    # "true" → server-side mock (code: 000000)

# -------------------------------------------------------------
# DigiLocker (Aadhaar identity, OAuth + PKCE)
# -------------------------------------------------------------
NEXT_PUBLIC_USE_REAL_DIGILOCKER=
DIGILOCKER_ENABLED=          # "true" master kill-switch
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=
DIGILOCKER_BASE_URL=
MOCK_DIGILOCKER=             # "true" → server-side mock

# -------------------------------------------------------------
# Cloudflare Images (admit-letter direct-creator-upload)
# -------------------------------------------------------------
NEXT_PUBLIC_USE_REAL_CF_IMAGES=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGES_API_TOKEN=
MOCK_CLOUDFLARE_IMAGES=

# -------------------------------------------------------------
# Razorpay (premium ₹999 once)
# -------------------------------------------------------------
NEXT_PUBLIC_USE_REAL_RAZORPAY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MOCK_RAZORPAY=

# -------------------------------------------------------------
# Resend (transactional email)
# -------------------------------------------------------------
NEXT_PUBLIC_USE_REAL_RESEND=
RESEND_API_KEY=
RESEND_FROM_ADDRESS=NexGen Connect <hello@nexgenconnect.com>
MOCK_RESEND=

# -------------------------------------------------------------
# Web Push (chat / SLA notifications via push-fanout Inngest job)
# -------------------------------------------------------------
# VAPID keypair signs every push payload. Generate once with:
#   npx web-push generate-vapid-keys
# The public key is exposed to the browser via NEXT_PUBLIC_VAPID_PUBLIC_
# KEY so the Service Worker can subscribe; the private key stays server-
# side. VAPID_SUBJECT must be a mailto: or https: URL identifying the
# pusher (push providers reject malformed subjects).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@nexgenconnect.com

# -------------------------------------------------------------
# Inngest admin alerting (welcome-email + stale-signup + ts-sla)
# -------------------------------------------------------------
# Founder ping inbox. When unset the jobs log "would notify" to stdout
# and skip the email send — useful in dev so the Inngest UI still
# captures the run without burning Resend quota.
ADMIN_EMAIL=

# -------------------------------------------------------------
# Vercel AI Gateway (admit parse, scam classify, name match, triage)
# -------------------------------------------------------------
# Auth: VERCEL_OIDC_TOKEN is auto-injected on Vercel deployments AND
# pulled into local dev by `vercel env pull` — preferred path. The
# static gateway key is only needed on non-Vercel runtimes (CI, etc.)
# and gets manually rotated. Either is enough for the SDK.
AI_GATEWAY_API_KEY=
# Per-feature flags. Default is OFF in every environment until the
# operator has reviewed real output and is happy turning it on.
AI_ADMIT_PARSE_ENABLED=        # vision parse on admit-letter upload
AI_SCAM_DETECT_ENABLED=        # auto-file chat_report on high-confidence scams
AI_NAME_MATCH_ENABLED=         # LLM override for borderline DigiLocker name mismatches
AI_TRIAGE_ENABLED=             # one-line verdict prefix on /admin review rows
